# Example environment for the local proxy server
# UPSTREAM_URL should point to your model server's generate endpoint.
# For text-generation-inference (TGI) running locally on port 8080 you might use:
# UPSTREAM_URL=http://127.0.0.1:8080/generate

# Or for oobabooga/text-generation-webui (example) API endpoint:
# UPSTREAM_URL=http://127.0.0.1:5000/api/v1/generate

PORT=3001
UPSTREAM_URL=
UPSTREAM_API_TYPE=generic
